{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://samva.dev/schemas/openapi-release-manifest.json",
  "title": "Samva OpenAPI release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactVersion",
    "generatedAt",
    "generator",
    "compatibility",
    "openapi"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "artifactVersion": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[1-9][0-9]*$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "samva-openapi" },
        "version": { "type": "string" }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "baseline"],
      "properties": {
        "classification": { "enum": ["initial", "compatible", "breaking"] },
        "baseline": { "type": ["string", "null"] }
      }
    },
    "openapi": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "version", "apiVersion", "sha256", "bytes", "paths", "operations", "schemas"],
      "properties": {
        "artifact": { "const": "openapi.json" },
        "version": { "const": "3.1.0" },
        "apiVersion": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 1 },
        "paths": { "type": "integer", "minimum": 1 },
        "operations": { "type": "integer", "minimum": 1 },
        "schemas": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
